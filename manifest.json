{
  "manifest_version": 3,
  "name": "코코포리아 테마 커스터마이저",
  "version": "0.1.0",
  "description": "ccfolia.com 화면의 색상을 커스터마이징합니다 (테스트 버전)",
  "permissions": ["storage"],
  "host_permissions": ["https://ccfolia.com/*"],
  "content_scripts": [
    {
      "matches": ["https://ccfolia.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
